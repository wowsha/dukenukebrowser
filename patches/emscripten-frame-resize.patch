@@ -1427,5 +1427,21 @@ void videoGetModes(int display)
     SDL_CHECKFSMODES(maxx, maxy);
 
+#ifdef __EMSCRIPTEN__
+    // Some browser SDL backends report no discrete display modes. The caller
+    // skips video initialization entirely when validmodecnt remains zero.
+    if (validmodecnt == 0)
+    {
+        SDL_ADDMODE(640, 480, 8, 1);
+        initprintf("Emscripten: SDL reported no display modes; using 640x480 fallback.\n");
+    }
+#endif
+
     // add windowed modes next
     // SDL sorts display modes largest to smallest, so we can just compare with mode 0
-    SDL_GetDisplayMode(display, 0, &dispmode);
+    if (SDL_GetDisplayMode(display, 0, &dispmode) < 0 ||
+        dispmode.w <= 0 || dispmode.h <= 0)
+    {
+        // Some browser video drivers have no mode zero to query.
+        dispmode.w = maxx > 0 ? maxx : 640;
+        dispmode.h = maxy > 0 ? maxy : 480;
+    }
@@ -2068,9 +2084,47 @@ void videoShowFrame(int32_t w)
 {
     UNREFERENCED_PARAMETER(w);
 
+    // Publish the SDL software-frame state before any early return. This is
+    // intentionally browser-only and lets the host diagnostics identify a
+    // resize/minimize latch that would otherwise make the canvas stay black.
+#ifdef __EMSCRIPTEN__
+    EM_ASM({
+        var p = window.__e32VideoProbe || (window.__e32VideoProbe = {});
+        p.frameCalls = (p.frameCalls || 0) + 1;
+        p.lastFrame = ({
+            resizeX: $0, resizeY: $1, minimized: $2, lockcount: $3,
+            frameplace: $4, offscreenrendering: $5,
+            width: $6, height: $7, bpp: $8, at: performance.now()
+        });
+    }, sdl_resize.x, sdl_resize.y, sdl_minimized, lockcount,
+       (int)!!frameplace, offscreenrendering, xres, yres, bpp);
+#endif
+
     // if we're minimized or about to resize, just throw away the frame
     if (sdl_resize.x || sdl_minimized)
+    {
+#ifdef __EMSCRIPTEN__
+        EM_ASM({
+            var p = window.__e32VideoProbe || (window.__e32VideoProbe = {});
+            if ($0) p.resizeDrops = (p.resizeDrops || 0) + 1;
+            if ($1) p.minimizedDrops = (p.minimizedDrops || 0) + 1;
+            p.lastDroppedFrame = ({
+                resizeX: $0, resizeY: $1, minimized: $2, lockcount: $3,
+                frameplace: $4, at: performance.now()
+            });
+        }, sdl_resize.x, sdl_resize.y, sdl_minimized, lockcount, (int)!!frameplace);
+
+        // Do not strand a software-frame lock when SDL delivers a resize while
+        // a frame is in progress. handleevents() can only apply the pending
+        // resize when frameplace is clear; returning here with lockcount > 0
+        // otherwise wedges both the resize and every future presentation.
+        while (lockcount > 0 && frameplace)
+            videoEndDrawing();
+        if (!frameplace)
+            lockcount = 0;
+#endif
         return;
+    }
 
 #ifdef __ANDROID__
     if (mobile_halted) return;
@@ -2199,8 +2253,21 @@ void videoShowFrame(int32_t w)
     if (SDL_MUSTLOCK(sdl_surface)) SDL_UnlockSurface(sdl_surface);
 #if SDL_MAJOR_VERSION >= 2
-    if (SDL_UpdateWindowSurface(sdl_window))
+    int const surfaceUpdateResult = SDL_UpdateWindowSurface(sdl_window);
+#ifdef __EMSCRIPTEN__
+    EM_ASM({
+        var p = window.__e32VideoProbe || (window.__e32VideoProbe = {});
+        p.surfaceUpdates = (p.surfaceUpdates || 0) + 1;
+        p.lastSurfaceUpdate = ({
+            result: $0, width: $1, height: $2, bpp: $3,
+            lockcount: $4, canvasWidth: Module.canvas ? Module.canvas.width : null,
+            canvasHeight: Module.canvas ? Module.canvas.height : null,
+            at: performance.now()
+        });
+    }, surfaceUpdateResult, xres, yres, bpp, lockcount);
+#endif
+    if (surfaceUpdateResult)
     {
         // If a fullscreen X11 window is minimized then this may be required.
         // FIXME: What to do if this fails...
         sdl_surface = SDL_GetWindowSurface(sdl_window);
         SDL_UpdateWindowSurface(sdl_window);
